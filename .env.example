# Local development only. Copy to .env, update DB_PASSWORD, and load it into
# your shell or IDE environment as described in README.md.
# This RSA keypair is public, shared sample data. NEVER use it in production.
# Keep both keys unchanged across local restarts so LMS tokens remain valid.

DB_URL=jdbc:postgresql://localhost:5432/central_identity_dev
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

JWT_ISSUER=http://localhost:8080
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

